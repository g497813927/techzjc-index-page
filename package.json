{
  "name": "web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-licenses": "node ./scripts/generate-licenses.mjs",
    "prepare-env": "node ./scripts/prepare-env.mjs && npm run generate-licenses",
    "test": "npm run test:prepare-env && npm run test:scanner-404",
    "test:prepare-env": "node ./scripts/prepare-env.test.mjs",
    "test:scanner-404": "node --test ./scripts/scanner-404.test.mjs",
    "dev": "npm run prepare-env && next dev",
    "build": "npm run prepare-env && next build --webpack",
    "build:docker": "npm run prepare-env && next build --webpack && node ./scripts/sanitize-next-static-paths.mjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.10",
