    "@types/node": "^25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-helmet": "^6.1.11",
    "@types/unist": "^3.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.7",
    "tailwindcss": "^4"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    },
    "ajv": ">=8.18.0",
    "eslint": {
      "ajv": "6.14.0"
    },
    "minimatch": ">=10.2.1",
