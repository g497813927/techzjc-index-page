{
  "routes": [
    {
      "src": "/.*",
      "methods": ["TRACE"],
      "status": 404,
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sentry-monitor",
      "schedule": "0 0 * * *"
    }
  ]
}
